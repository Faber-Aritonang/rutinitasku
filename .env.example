# ===========================================
# NaraTask AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ----- LLM Configuration -----
# Anthropic Claude API (Primary)
ANTHROPIC_API_KEY=sk-ant-xxx-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# NaraRouter API (Fallback) - https://router.bynara.id
NARAROUTER_API_KEY=sk-nry-xxx-your-key-here
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# ----- Email Configuration (Optional) -----
# IMAP Settings (for reading emails)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SMTP Settings (for sending emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ----- Google Calendar (Optional) -----
# Path to Google OAuth2 credentials file
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ----- Application Settings -----
# Server host and port
HOST=0.0.0.0
PORT=7860

# Debug mode (set to false in production)
DEBUG=true

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# Workspace directory for file operations
WORKSPACE_DIR=./data/workspace

# Database path
DATABASE_PATH=./data/memory.db